# Local development environment variables.
# Copy this file to apps/client/.env.local and fill in your Firebase project's config
# (Firebase Console -> Project Settings -> General -> Your apps -> Web app).
#
# The app is serverless P2P — Firebase Realtime Database is the only backend. There is no
# app server, no database to run locally, and no docker-compose setup. See DEPLOYMENT.md
# for full Firebase project setup instructions, including the RTDB security rules.

EXPO_PUBLIC_FIREBASE_API_KEY=...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=...
EXPO_PUBLIC_FIREBASE_DATABASE_URL=...
EXPO_PUBLIC_FIREBASE_PROJECT_ID=...
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=...
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=...
EXPO_PUBLIC_FIREBASE_APP_ID=...

# Set to "true" to connect to a local Firebase RTDB emulator instead of the real project
# (pnpm exec firebase emulators:start --only database --project demo-dabb). See CLAUDE.md's
# E2E smoke test section and dev.sh.
# EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true

# Analytics — Umami (optional; only needed to test analytics locally)
# EXPO_PUBLIC_UMAMI_URL=http://localhost:3001
# EXPO_PUBLIC_UMAMI_WEBSITE_ID=
