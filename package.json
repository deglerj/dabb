{
  "name": "dabb",
  "version": "4.2.2",
  "private": true,
  "type": "module",
  "description": "Binokel card game - multiplayer installable PWA",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck",
    "simulate": "pnpm --filter @dabb/simulate simulate",
    "postinstall": "bash scripts/setup-hooks.sh"
  },
  "devDependencies": {
    "firebase-tools": "^15.25.1",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.76.0",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "!(pnpm-lock).{json,md,yml,yaml}": [
      "oxfmt"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@10.33.0"
}
