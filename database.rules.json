{
  "rules": {
    "lobby": {
      ".read": "auth == null",
      "$code": { ".write": "auth == null" }
    },
    "sessions": {
      "$code": {
        ".read": "auth == null",
        ".write": "!newData.exists() && data.child('meta/status').val() === 'waiting' && data.child('meta/createdAt').val() < now - 3600000",
        "meta": {
          ".write": "!data.exists()",
          "status": { ".write": "auth == null" },
          "playerCount": { ".write": "!data.exists()" },
          "targetScore": { ".write": "!data.exists()" },
          "createdAt": { ".write": "!data.exists()" },
          "players": {
            "$playerIndex": {
              ".write": "!data.exists() || (data.child('isAI').val() === true && root.child('sessions/' + $code + '/meta/status').val() === 'waiting')"
            }
          }
        },
        "events": {
          "$eventId": {
            ".write": "root.child('sessions/' + $code + '/meta/players').child('0/secretHash').val() === newData.child('authorHash').val() || root.child('sessions/' + $code + '/meta/players').child('1/secretHash').val() === newData.child('authorHash').val() || root.child('sessions/' + $code + '/meta/players').child('2/secretHash').val() === newData.child('authorHash').val() || root.child('sessions/' + $code + '/meta/players').child('3/secretHash').val() === newData.child('authorHash').val()"
          }
        },
        "presence": {
          "$playerIndex": { ".write": "auth == null" }
        },
        "emotes": {
          "$playerIndex": { ".write": "auth == null" }
        },
        "aiClaims": {
          "$claimId": { ".write": "auth == null" }
        },
        "rematch": {
          "votes": {
            "$playerIndex": { ".write": "auth == null" }
          },
          "code": { ".write": "auth == null" }
        }
      }
    }
  }
}
